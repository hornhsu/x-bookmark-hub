{
  "manifest_version": 3,
  "name": "X Bookmark Hub",
  "version": "1.0.0",
  "description": "Incremental X/Twitter bookmark sync and management extension for X Bookmark Hub.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://x.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
