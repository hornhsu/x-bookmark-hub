# X Bookmark Hub environment configuration
# Copy to .env before running docker compose

# Required when exposing the server on a VM / Tailscale / LAN IP
XBH_API_KEY=change-me-to-a-long-random-token

# Host bind IP for Docker port mapping (use 127.0.0.1 for local/tailscale serve, or your Tailscale IP)
XBH_BIND_HOST=127.0.0.1
XBH_PORT=7799

# Optional: LLM summarization (OpenAI-compatible API)
# XBH_LLM_API_BASE=https://api.openai.com/v1
# XBH_LLM_API_KEY=
# XBH_LLM_MODEL=gpt-4o-mini
